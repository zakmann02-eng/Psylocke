# Wallets Psylocke watches, comma-separated.
TRACKED_WALLETS=0x2005d16a84ceefa912d4e380cd32e7ff827875ea,0x751a2b86cab503496efd325c8344e10159349ea1

# Your total trading bankroll in USD. Used to scale copied trades
# proportionally to each tracked wallet's portfolio value.
BANKROLL_USD=0

# Keep this "true" until you've reviewed real signals in the `signals`
# table and are ready to risk real funds. The bot will not place a live
# order while this is true.
DRY_RUN=true

# How often (seconds) the bot polls, in always-on deployments.
POLL_INTERVAL_SECONDS=30

# Buffer (seconds) a signal must sit for before the bot will act on it.
EXECUTION_DELAY_SECONDS=20

# Safety cap in USD per entry order. 0 = no cap (pure proportional sizing).
MAX_POSITION_USD=0

# Skip entries computed below this USD size.
MIN_TRADE_USD=1

# How long (days) to keep resolved signals/dedup records before pruning
# them. Only used by run_cron.py, which prunes on every pass so the
# database (and the volume it lives on) stays small indefinitely. PENDING
# signals and position ledgers are never pruned regardless of age.
RETENTION_DAYS=30

DB_PATH=data/psylocke.db
DATA_API_BASE=https://data-api.polymarket.com
CLOB_API_BASE=https://clob.polymarket.com

# Only needed once DRY_RUN=false.
# Private key for the wallet/API credentials that will sign and fund orders.
# Never commit this file with a real value filled in.
POLY_PRIVATE_KEY=

# The Polymarket proxy wallet that actually holds your USDC and settles
# trades -- not necessarily the same address as the key above. Find it at
# polymarket.com/profile/<address> after logging into the account you want
# trading from (the address in that URL is it).
POLY_FUNDER_ADDRESS=

POLY_CHAIN_ID=137

# Must match how the trading account logs into Polymarket:
#   0 = EOA (raw private key, no proxy wallet)
#   1 = POLY_PROXY (email / magic-link login)
#   2 = POLY_GNOSIS_SAFE (browser wallet, e.g. MetaMask -- most accounts)
POLY_SIGNATURE_TYPE=2

# Only copy trades in markets tagged as being about US topics (politics,
# elections, US economy, etc.) -- see us_market_tags default in config.py.
# A market whose tags can't be determined is skipped, not assumed safe.
REQUIRE_US_MARKETS=true

# Override the default US-topic tag allowlist (comma-separated, matched
# case-insensitively against each market's Polymarket tags). Only needed
# if the default in config.py doesn't match what you see on real markets.
# US_MARKET_TAGS=politics,us-politics,us-current-affairs,us-election,elections,congress,supreme-court,fed,federal-reserve,us-economy,economy

GAMMA_API_BASE=https://gamma-api.polymarket.com

# Optional: real-time play-by-play in Telegram. Leave blank to disable --
# the bot logs locally either way, this just also pushes notifications.
# See README for how to create a bot via @BotFather and find your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
